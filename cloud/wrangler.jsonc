{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ielts-atlas-private",
  "account_id": "44a579cc0bf6251392e6555f53e73007",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../dist/private",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ielts-atlas-private",
    "database_id": "0d77c0d6-2f98-4d1a-b0b4-5ab4c4196567",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": false }
}
